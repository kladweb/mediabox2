{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mediabox",
  "main": "./src/index.ts",
  "compatibility_date": "2026-11-05",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/ru",
      "/ru/*",
      "/en",
      "/en/*"
    ]
  },
  "previews": {}
}
