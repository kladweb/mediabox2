{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mediabox2",
  "compatibility_date": "2026-11-05",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "previews": {}
}
